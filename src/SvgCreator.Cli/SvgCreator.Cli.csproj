<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SvgCreator.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>svgcreator</ToolCommandName>
    <PackageId>SvgCreator.Cli</PackageId>
    <Description>Command-line tool that converts images into line-art SVGs.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SvgCreator/SvgCreator.csproj" />
    <PackageReference Include="System.CommandLine" />
    <!-- Skia's native library for Linux without fontconfig/freetype system dependencies. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
